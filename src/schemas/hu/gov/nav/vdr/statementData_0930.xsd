            <xs:element name="taxBaseInInvoiceCurrency" type="earbase:TaxMonetaryType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Adó alapja számla pénznemében</xs:documentation>
                    <xs:documentation xml:lang="en">Tax base in invoice currency</xs:documentation>
