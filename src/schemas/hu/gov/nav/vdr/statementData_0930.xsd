            </xs:element>
            <xs:element name="currency" type="common:CurrencyType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Pénznem (ISO 4217 szabvány szerinti 3 hosszú pénznem kód)</xs:documentation>
                    <xs:documentation xml:lang="en">Currency (three digit ISO 4217 currency code)</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
