    <!-- COMPLEX TYPES -->

    <xs:complexType name="ReasonsForCorrectionForSupplyAndAcquisitionsOfServicesType">
        <xs:annotation>
            <xs:documentation xml:lang="hu">Helyesbítés oka lista típus szolgáltatásnyújtáshoz és szolgáltatás igénybevételhez</xs:documentation>
            <xs:documentation xml:lang="en">Reason for correction list for supply and acquisitions of services type</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="taxIdentificationNumberOrCountryCodeCorrection" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Adószám helytelensége miatti javítás, ideértve az országkód elírása miatti javítást is</xs:documentation>
                    <xs:documentation xml:lang="en">Correction of incorrect tax number, including correction of misspelled country code</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="amountDataCorrection" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Összegadat helytelensége miatti javítás</xs:documentation>
                    <xs:documentation xml:lang="en">Correction of incorrect amount data</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="periodDateCorrection" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Hibás időszak miatti javítás</xs:documentation>
                    <xs:documentation xml:lang="en">Correction of incorrect period data</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ReasonsForCorrectionForSupplyAndAcquisitionsOfIntraCommunityType">
        <xs:annotation>
            <xs:documentation xml:lang="hu">Helyesbítés oka lista közösségi termékértékesítéshez és termékbeszerzéshez</xs:documentation>
            <xs:documentation xml:lang="en">Reason for correction for supply and acquisitions of intra community list</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="taxIdentificationNumberOrCountryCodeCorrection" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Adószám helytelensége miatti javítás, ideértve az országkód elírása miatti javítást is</xs:documentation>
                    <xs:documentation xml:lang="en">Correction of incorrect tax number, including correction of misspelled country code</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="amountDataCorrection" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Összegadat helytelensége miatti javítás</xs:documentation>
                    <xs:documentation xml:lang="en">Correction of incorrect amount data</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="periodDateCorrection" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Hibás időszak miatti javítás</xs:documentation>
                    <xs:documentation xml:lang="en">Correction of incorrect period data</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="triangularTransactionNotMarked" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Háromszögügylet, de ezt nem jelölte</xs:documentation>
                    <xs:documentation xml:lang="en">Triangular transaction not marked</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notTriangularTransactionMarked" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation xml:lang="hu">Nem háromszögügylet, de annak jelölte</xs:documentation>
                    <xs:documentation xml:lang="en">Not triangular transaction but marked</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="SourceDocumentItemType">
